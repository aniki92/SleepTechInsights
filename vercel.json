{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sleeptechinsights.com" }],
      "destination": "https://www.sleeptechinsights.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/posts/:slug/", "destination": "/post.html?slug=:slug" },
    { "source": "/blog",        "destination": "/#blog" },
    { "source": "/blog/",       "destination": "/#blog" },
    { "source": "/reviews",     "destination": "/#reviews" },
    { "source": "/reviews/",    "destination": "/#reviews" },
    { "source": "/guides",      "destination": "/#guides" },
    { "source": "/guides/",     "destination": "/#guides" },
    { "source": "/newsletter",  "destination": "/#newsletter" },
    { "source": "/newsletter/", "destination": "/#newsletter" }
  ],
  "headers": [
    {
      "source": "/style.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/posts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    },
    {
      "source": "/:path*/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}